// Prisma schema — мультитенант (single-DB PostgreSQL, clinic_id во всех таблицах)
// Подход: одна БД на все клиники. Изоляция по clinic_id + композитный
// уникальный индекс [clinicId, username] — позволяет логин "admin" в разных клиниках.
// Зарезервировано поле Clinic.dbUrl для будущего перехода на DB-per-tenant.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // В DATABASE_URL НЕ должно быть sslmode=require, ssl=true, channel_binding.
  // База доступна только из внутренней сети — TLS не используется.
  // См. .env.example.
}

// ============ КЛИНИКИ ============
model Clinic {
  id          String   @id @default(cuid())
  slug        String   @unique // 'acme-vet' — для входа и URL
  name        String   // Название клиники
  address     String?
  phone       String?
  plan        String   @default("free") // free | basic | pro
  visitLimit  Int     @default(10)
  // Зарезервировано для будущего DB-per-tenant: если задан — роутер направляет
  // запросы в отдельную БД этой клиники. Пока null — все клиники в общей БД.
  dbUrl       String?
  status      String   @default("active") // 'active' | 'suspended'
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       ClinicUser[]
  visits      Visit[]
  sessions    Session[]
}

// ============ ПОЛЬЗОВАТЕЛИ КЛИНИКИ ============
// КЛЮЧЕВОЕ: @@unique([clinicId, username]) — логин уникален только внутри клиники.
// → admin@acme и admin@other — разные строки, обе валидны.
model ClinicUser {
  id          String   @id @default(cuid())
  clinicId    String
  username    String   // lowercase, без пробелов; уникален ВНУТРИ клиники
  password    String   // bcrypt hash
  displayName String   // ФИО врача
  role        String   @default("vet") // 'admin' | 'vet' | 'receptionist'
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clinic      Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  visits      Visit[]
  sessions    Session[]

  @@unique([clinicId, username]) // ← повторный admin в разных клиниках — OK
  @@index([clinicId])
  @@index([username])
}

// ============ ВИЗИТЫ (ПРИЁМЫ) ============
model Visit {
  id              String   @id @default(cuid())
  clinicId        String
  doctorId        String
  species         String
  weight          String
  visitDate       String
  anamnesis       Json
  examination     Json
  auscultation    Json
  scans           Json
  results         Json
  aiResult        String?
  aiGeneratedAt   String?
  visitStartedAt  Int?
  visitEndedAt    Int?
  visitDurationMs Int      @default(0)
  visitSummary    String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  clinic          Clinic     @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctor          ClinicUser @relation(fields: [doctorId], references: [id])

  @@index([clinicId])
  @@index([doctorId])
}

// ============ СЕССИИ ============
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  clinicId  String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user   ClinicUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinic Clinic     @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([clinicId])
}
