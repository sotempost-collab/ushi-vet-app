# ─────────────────────────────────────────────────────────────────
# Конфигурация подключения к БД для мультитенантного приложения.
# ─────────────────────────────────────────────────────────────────
#
# ВАЖНО: на relaxdev TLS НЕ используется — база доступна только из
# внутренней сети. В строке ниже НЕ ДОЛЖНО быть параметров:
#   sslmode=require, ssl=true, channel_binding=require
# С ними подключение упадёт с ошибкой:
#   "server does not support SSL connections"
#
# Драйвер в schema.prisma → provider = "postgresql", без sslmode в URL.

# Пример для PostgreSQL в внутренней сети (БЕЗ ssl):
# DATABASE_URL="postgresql://user:password@10.0.0.5:5432/ushi_vet?schema=public"

# Пример для PostgreSQL через unix-socket:
# DATABASE_URL="postgresql://user:password@/var/run/postgresql/ushi_vet?schema=public"

# Пример для локальной разработки (SQLite, только для тестов):
# DATABASE_URL="file:./db/custom.db"

# Текущая активная конфигурация (замените на PostgreSQL-URL перед деплоем):
DATABASE_URL="file:./db/custom.db"
