# Переменные окружения для AI ключей
# Задайте на relaxdev.ru → проект → «Переменные окружения»
#
# После добавления — нажмите «Запустить редеплой»
# Next.js встроит ключи в клиентский bundle при сборке

# Polza.ai — основной источник AI (быстрый, 3-5с)
# Получить ключ: https://polza.ai
NEXT_PUBLIC_POLZA_API_KEY=

# AnyModel.org — резервный fallback
# Получить ключ: https://anymodel.org
NEXT_PUBLIC_ANYMODEL_API_KEY=
